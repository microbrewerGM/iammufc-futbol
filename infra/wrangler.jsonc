// M1 (PoC) configuration. D1 + KV only — deliberately no R2, Queues,
// Workflows, Durable Objects or Containers, so the PoC runs on the free plan.
// Containers are what force Workers Paid; they arrive at M4.
//
// Real resource ids, created 2026-08-19 (docs/runbooks/m0-github-setup.md §7).
// Dev only, by decision 2026-08-22: this project has no `production`
// environment. The `iammufc-prod` D1/KV pair that briefly existed is being
// decommissioned (docs/exceptions.md E-011, now closed as moot -- there is
// no CF_TOKEN_PROD left to scope). Getting `database_id` wrong here is still
// the actual failure mode on the one environment that remains; review
// accordingly (self-review-protocol.md Tier 2).
//
// VERIFY the current schema against developers.cloudflare.com before use.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iammufc",
  "main": "../worker/src/index.ts",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "../worker/public",
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true },

  // Edge caching for GET responses (Cache-Control headers set per-route in
  // worker/src/index.ts). Requires wrangler >= 4.69.0 (pinned: 4.123.0).
  // Invalidation is redeploy-based, not purge-based: the Worker version is
  // part of the cache key, so nightly-refresh.yml's unconditional
  // `wrangler deploy` after a new snapshot already invalidates every cached
  // response -- see that workflow's own comment. No ctx.cache.purge() logic
  // needed here as a result.
  "cache": { "enabled": true },

  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "iammufc-dev",
          "database_id": "78c069cc-e735-4970-94c2-4affbabc0d2e",
          // Keeps local and preview writes off any shared database.
          "preview_database_id": "78c069cc-e735-4970-94c2-4affbabc0d2e"
        }
      ],
      "kv_namespaces": [{ "binding": "CFG", "id": "e2ea049a4f414b4cb4d0a600cbb8d802" }],
      "ai": { "binding": "AI" }

      // M2 — football-data.org key. ToS 6.1 forbids keys in OSS repos, so it
      // lives in Secrets Store and is bound at runtime, never in the tree.
      // "secrets_store_secrets": [
      //   { "binding": "FOOTBALL_DATA_KEY", "store_id": "<store>",
      //     "secret_name": "football-data-key" }
      // ]
    }
  }

  // M2 — nightly batch:
  // "triggers": { "crons": ["0 5 * * *"] },
  //
  // M2 — R2 lakehouse (bronze/silver/gold + rendered artifacts):
  // "r2_buckets": [
  //   { "binding": "BRONZE", "bucket_name": "iammufc-bronze-<env>" },
  //   { "binding": "GOLD",   "bucket_name": "iammufc-gold-<env>" }
  // ],
  //
  // M3 — async materialization. SQLite-backed Durable Objects are available
  // on the free plan (verified 2026-08-21: 100k requests/day, 13k GB-s/day,
  // no storage charge on free tier) -- not paid-plan-gated like Containers
  // below. Deliberately not built yet regardless: there is no real
  // expensive-artifact pipeline for a job queue or single-flight dedup to
  // coordinate access to until M2's ingest lands. Building it now would sit
  // unused.
  // "queues": { "producers": [...], "consumers": [...] },
  // "durable_objects": { "bindings": [{ "name": "ARTIFACT", ... }] },
  //
  // M4 — Python pipeline. THIS is the line that requires Workers Paid.
  // "containers": [
  //   { "class_name": "PipelineContainer", "image": "../pipeline/Dockerfile",
  //     "instance_type": "standard-1" }   // 0.5 vCPU / 4 GiB / 8 GB
  // ]
}
